# SharpClaw install environment. scripts/install.sh copies this to .env (mode 600) and fills in
# ADMIN_KEY and SHARPCLAW_UID/GID. Never commit .env.

# Admin key for the client API (any strong random string). Required.
ADMIN_KEY=

# OpenRouter API key. Required when PROVIDER_TYPE=OpenRouter.
OPENROUTER_API_KEY=

# Optional OpenRouter management key, used only to show remaining credits in the web UI.
OPENROUTER_MANAGEMENT_KEY=

# Provider selection: OpenRouter or Fake.
PROVIDER_TYPE=OpenRouter

# OTLP telemetry endpoints (full signal-specific URLs). Leave empty for console-only.
# Metrics -> VictoriaMetrics, e.g. http://host:8428/opentelemetry/v1/metrics
OTEL_METRICS_ENDPOINT=
# Logs -> Loki (3.0+), e.g. http://host:3100/otlp/v1/logs
OTEL_LOGS_ENDPOINT=

# Agent tokens, one per agent service in compose.yml (issued by: sharpclaw agents create ...).
AGENT_ASSISTANT_TOKEN=
AGENT_CODER_TOKEN=

# Host uid/gid that owns ./data and ./agents/*/workspace (`id -u` / `id -g`). The gateway and
# agent containers run as this user so they can write there. Defaults to 1000:1000.
SHARPCLAW_UID=
SHARPCLAW_GID=

# Image tag to run (built by scripts/build-images.sh in the repo). Defaults to latest; set a
# git sha to pin or roll back.
SHARPCLAW_TAG=

# Address and port the client port (API + web UI) is published on. 127.0.0.1 = this machine only.
# For the web UI from other devices on your home LAN, set CLIENT_BIND to this host's LAN address
# (e.g. 192.168.1.20) or 0.0.0.0. Plain HTTP: never port-forward it from your router.
CLIENT_BIND=
CLIENT_PORT=
