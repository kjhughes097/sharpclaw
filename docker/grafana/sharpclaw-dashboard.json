{
  "__inputs": [],
  "__requires": [],
  "title": "SharpClaw Gateway",
  "uid": "sharpclaw-gateway",
  "tags": [
    "sharpclaw"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "metrics",
        "label": "Metrics (VictoriaMetrics)",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "logs",
        "label": "Logs (Loki)",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "agent",
        "label": "Agent",
        "type": "query",
        "datasource": "${metrics}",
        "query": "label_values({__name__=\"sharpclaw.llm.calls\"}, agent)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "correlation_id",
        "label": "correlation_id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About metric names",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Metric names are the **actual names landed in VictoriaMetrics** (verified by the smoke test, see `docs/telemetry-notes.md`): OTel names are kept verbatim with dots, counters have **no** `_total` suffix and histograms only add `_bucket`/`_sum`/`_count`. Dotted names must be selected as `{__name__=\"sharpclaw.llm.calls\"}`."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "LLM calls by status (rate/min)",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "expr": "sum by (status) (rate({__name__=\"sharpclaw.llm.calls\", agent=~\"$agent\"}[5m])) * 60",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cost over last 24h per agent (USD) vs remaining budget",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "targets": [
        {
          "expr": "sum by (agent) (increase({__name__=\"sharpclaw.llm.cost_usd\", agent=~\"$agent\"}[24h]))",
          "legendFormat": "{{agent}} spent"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Budget remaining per agent (USD)",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "expr": "max by (agent) ({__name__=\"sharpclaw.budget.remaining_usd\", agent=~\"$agent\"})",
          "legendFormat": "{{agent}} remaining"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Call duration p50/p95 (s)",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate({__name__=\"sharpclaw.llm.duration_bucket\", agent=~\"$agent\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=\"sharpclaw.llm.duration_bucket\", agent=~\"$agent\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Time to first token p50/p95 (s)",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate({__name__=\"sharpclaw.llm.time_to_first_token_bucket\", agent=~\"$agent\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=\"sharpclaw.llm.time_to_first_token_bucket\", agent=~\"$agent\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tokens by type (rate/min)",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "expr": "sum by (type) (rate({__name__=\"sharpclaw.llm.tokens\", agent=~\"$agent\"}[5m])) * 60",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Inbox depth",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "expr": "max by (agent) ({__name__=\"sharpclaw.inbox.depth\", agent=~\"$agent\"})",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Agent last-seen age (s)",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 27
      },
      "targets": [
        {
          "expr": "time() - max by (agent) ({__name__=\"sharpclaw.agent.last_seen\", agent=~\"$agent\"})",
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Budget rejections & auth failures (rate/min)",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 27
      },
      "targets": [
        {
          "expr": "sum by (agent) (rate({__name__=\"sharpclaw.budget.exceeded\", agent=~\"$agent\"}[5m])) * 60",
          "legendFormat": "budget rejected {{agent}}"
        },
        {
          "expr": "sum by (listener) (rate({__name__=\"sharpclaw.auth.failures\"}[5m])) * 60",
          "legendFormat": "auth fail {{listener}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Tool calls by tool and status (rate/min)",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "targets": [
        {
          "expr": "sum by (tool, status) (rate({__name__=\"sharpclaw.tool.calls\", agent=~\"$agent\"}[5m])) * 60",
          "legendFormat": "{{tool}} {{status}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Approvals by status (rate/min)",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "targets": [
        {
          "expr": "sum by (status) (rate({__name__=\"sharpclaw.approvals\", agent=~\"$agent\"}[5m])) * 60",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Pending approvals",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 53
      },
      "targets": [
        {
          "expr": "max by (agent) ({__name__=\"sharpclaw.approvals.pending\", agent=~\"$agent\"})",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Approval decision time p50/p95 (s)",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 53
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, status) (rate({__name__=\"sharpclaw.approval.decision_time_bucket\", agent=~\"$agent\"}[1h])))",
          "legendFormat": "p50 {{status}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, status) (rate({__name__=\"sharpclaw.approval.decision_time_bucket\", agent=~\"$agent\"}[1h])))",
          "legendFormat": "p95 {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Unreported tool calls (older than 5 min)",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 53
      },
      "targets": [
        {
          "expr": "max by (agent) ({__name__=\"sharpclaw.tool.unreported\", agent=~\"$agent\"})",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Context truncations & rejections (rate/min)",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 61
      },
      "targets": [
        {
          "expr": "sum by (agent) (rate({__name__=\"sharpclaw.context.truncations\", agent=~\"$agent\"}[5m])) * 60",
          "legendFormat": "truncated {{agent}}"
        },
        {
          "expr": "sum by (agent) (rate({__name__=\"sharpclaw.context.rejections\", agent=~\"$agent\"}[5m])) * 60",
          "legendFormat": "rejected {{agent}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Logins by result (rate/min)",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 61
      },
      "targets": [
        {
          "expr": "sum by (result) (rate({__name__=\"sharpclaw.auth.logins\"}[5m])) * 60",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Auth failures by method (rate/min)",
      "datasource": "${metrics}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 61
      },
      "targets": [
        {
          "expr": "sum by (listener, method) (rate({__name__=\"sharpclaw.auth.failures\"}[5m])) * 60",
          "legendFormat": "{{listener}} {{method}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Gateway logs",
      "datasource": "${logs}",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 69
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{service_name=\"sharpclaw-gateway\"} | correlation_id=`$correlation_id`",
          "queryType": "range"
        }
      ]
    }
  ]
}
