# Gateway image: multi-stage build, non-root, no secrets baked in.

# 1. The web UI (3.3). Node LTS matches ui/.nvmrc; output becomes the gateway's wwwroot.
FROM node:24-bookworm-slim AS ui
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY ui/ ./
RUN npm run build

# 2. The gateway.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
# Shown by GET /api/system; pass the git short sha (compose sets it from GIT_SHA).
ARG GIT_SHA=dev

COPY Directory.Build.props ./
COPY src/SharpClaw.Contracts/ src/SharpClaw.Contracts/
COPY src/SharpClaw.Gateway/ src/SharpClaw.Gateway/
RUN dotnet restore src/SharpClaw.Gateway/SharpClaw.Gateway.csproj
RUN dotnet publish src/SharpClaw.Gateway/SharpClaw.Gateway.csproj -c Release -o /app -p:InformationalVersion=$GIT_SHA

# 3. The speech-to-text model for voice input (voice spec section 1), pinned by sha256. Another
#    model needs both args (e.g. WHISPER_MODEL=small.en plus its sha256 from Hugging Face);
#    an empty WHISPER_MODEL builds an image without voice input.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS model
ARG WHISPER_MODEL=base.en
ARG WHISPER_MODEL_SHA256=a03779c86df3323075f5e796cb2ce5029f00ec8869eee3fdfb897afe36c6d002
RUN mkdir -p /models && if [ -n "$WHISPER_MODEL" ]; then \
      curl -fsSL -o "/models/ggml-$WHISPER_MODEL.bin" \
        "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-$WHISPER_MODEL.bin" && \
      echo "$WHISPER_MODEL_SHA256  /models/ggml-$WHISPER_MODEL.bin" | sha256sum -c -; \
    fi

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
ARG WHISPER_MODEL=base.en
# whisper.cpp (voice input) needs the OpenMP runtime.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app .
COPY --from=ui /ui/dist ./wwwroot
COPY --from=model /models ./models
# Empty (voice input off) when the image was built without a model.
ENV Transcription__ModelPath=${WHISPER_MODEL:+/app/models/ggml-${WHISPER_MODEL}.bin}

# Kestrel endpoints are configured in code (8080 client, 8081 agent); disable the
# image default so we do not double-bind a port.
ENV ASPNETCORE_HTTP_PORTS=

# Non-root user; /data holds the SQLite file (the install's ./data bind mount).
# The .NET images ship a predefined non-root user named "app".
RUN mkdir -p /data && chown app:app /data
USER app

EXPOSE 8080 8081
ENTRYPOINT ["dotnet", "SharpClaw.Gateway.dll"]
