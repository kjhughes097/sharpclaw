# Required for gateway admin authentication.
ADMIN_KEY=

# Required only when PROVIDER_TYPE=OpenRouter.
OPENROUTER_API_KEY=

# Set to Fake to run without an upstream provider.
PROVIDER_TYPE=OpenRouter

# Optional OTLP HTTP/protobuf endpoints.
OTEL_METRICS_ENDPOINT=
OTEL_LOGS_ENDPOINT=

# Set after creating the assistant agent through the CLI.
AGENT_ASSISTANT_TOKEN=
